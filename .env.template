# Configuration for Grist MCP Server
# Make a copy of this file as .env and fill in your actual API key

# Grist API Key (required)
# Get this from your Grist account settings
GRIST_API_KEY=your_api_key_here

# Grist API URL (optional, defaults to https://docs.getgrist.com/api)
# Use this to connect to another Grist instance.
# GRIST_API_URL takes precedence over GRIST_API_HOST if both are set;
# docker-compose.yml passes GRIST_API_HOST to the containers.
# GRIST_API_URL=https://docs.getgrist.com/api
GRIST_API_HOST=https://grist.numerique.gouv.fr/api


# Log level (optional, defaults to INFO)
# Available options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
